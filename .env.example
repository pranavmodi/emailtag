# FastAPI settings
API_V1_PREFIX=/api/v1
DEBUG=True
PROJECT_NAME=EmailTag
VERSION=0.1.0

# SSL/TLS Settings
SSL_ENABLED=True
SSL_CERT_FILE=/path/to/your/fullchain.pem
SSL_KEY_FILE=/path/to/your/privkey.pem
FORCE_HTTPS=True

# Database
# Use 'db' as hostname when running with Docker Compose, 'localhost' for local dev
DATABASE_URL=postgresql://postgres:postgres@db:5432/emailtag
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/emailtag

# Celery
# Use 'rabbitmq' as hostname when running with Docker Compose, 'localhost' for local dev
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@db:5432/emailtag
INBOX_AUDIT_LOOKBACK_HOURS=24

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# Optional. Used by pifstats research/behavior/signature tasks; falls back to OPENAI_API_KEY.
OPENAI_RESEARCH_API_KEY=

# FrontApp
FRONTAPP_API_KEY=your_frontapp_api_key
FRONTAPP_WEBHOOK_SECRET=your_frontapp_webhook_secret

# Autorespond Settings
AUTORESPOND_ENABLED=True

# Document Processing Settings  
DOCUMENT_ANALYSIS_MODEL=gpt-5.2

# Logging
LOG_LEVEL=INFO

# RadFlow Contact Verification API
RADFLOW_CONTACT_VERIFY_URL=https://staging-app.radflow360.com/chatbotapi/Patient/contactVerifyEmail
RADFLOW_CONTACT_VERIFY_AUTH=Basic your_base64_encoded_credentials
