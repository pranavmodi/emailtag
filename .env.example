# FastAPI settings
API_V1_PREFIX=/api/v1
DEBUG=True
PROJECT_NAME=EmailTag
VERSION=0.1.0

# SSL/TLS Settings
SSL_ENABLED=True
SSL_CERT_FILE=/path/to/your/fullchain.pem
SSL_KEY_FILE=/path/to/your/privkey.pem
FORCE_HTTPS=True

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailtag
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emailtag

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=db+postgresql://postgres:postgres@localhost:5432/emailtag

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# FrontApp
FRONTAPP_API_KEY=your_frontapp_api_key
FRONTAPP_WEBHOOK_SECRET=your_frontapp_webhook_secret

# Autorespond Settings
AUTORESPOND_ENABLED=True

# Logging
LOG_LEVEL=INFO 